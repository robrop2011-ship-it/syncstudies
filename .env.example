# ─────────────────────────────────────────────────────────────────────────────
# SyncStudy — environment template (repo root)
#
#   cp .env.example .env
#
# This root file is what the Prisma CLI and the seed script read
# (`pnpm db:push`, `pnpm db:migrate`, `pnpm db:seed`, `pnpm db:studio`). The two
# apps have their own templates with the subset each one actually reads:
#
#   apps/web/.env.example        → apps/web/.env.local
#   apps/realtime/.env.example   → apps/realtime/.env
#
# Every value below is a working LOCAL DEFAULT for the stack started by
# `pnpm services:up`. Nothing here is a production value; nothing here is secret.
#
# Amendment A1: accounts are website-only. There is deliberately NO SMTP host, no
# Resend/Postmark key, no mail-from address and no OAuth client anywhere in this
# file. If you find yourself adding one, read docs/ADR/0001-website-only-accounts.md
# first.
# ─────────────────────────────────────────────────────────────────────────────


# ── Data stores ─────────────────────────────────────────────────────────────

# Postgres connection string. Matches the postgres service in
# infra/docker-compose.dev.yml (user/password/db all `syncstudy`).
# Production: the Neon pooled connection string.
DATABASE_URL="postgresql://syncstudy:syncstudy@localhost:5432/syncstudy?schema=public"

# Redis, holding the live room tier: presence, video anchors, rate-limit buckets,
# leader locks (PLAN.md §7.3). Everything in here is reconstructible from Postgres.
# Production: the Upstash URL, which is `rediss://` (two s's — TLS).
REDIS_URL="redis://localhost:6379"


# ── Secrets you must generate yourself ──────────────────────────────────────

# Salt for hashing IP addresses before they are stored for abuse tracking. Raw
# addresses are never written to a row or a log line (PLAN.md §11.9); a per-
# environment salt means a database leak cannot be reversed into a list of
# student IPs with a rainbow table.
#
#   Generate:  openssl rand -base64 32
#          or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating this invalidates existing abuse counters, which is fine and expected.
IP_HASH_SALT="dev-ip-hash-salt-change-me"

# Shared secret for coturn's REST credential mechanism. The realtime service signs
# `<expiry>:<userId>` with HMAC-SHA1 under this secret and hands the result to the
# browser as a 10-minute TURN credential (PLAN.md §9.3). It must be byte-identical
# to `static-auth-secret` in infra/coturn/turnserver.conf — a mismatch fails every
# TURN allocation with a 401 that looks exactly like an outage.
#
#   Generate:  openssl rand -base64 32
#
# The value below matches the dev-only secret checked into the coturn config, so
# local calls work with no setup. NEVER deploy this value.
TURN_SECRET="dev-turn-secret-change-me"

# ICE servers offered to the browser, comma-separated. STUN is free and stateless;
# TURN relays when a direct connection is impossible (~10-15% of peer pairs). Keep
# a TCP entry and, in production, a `turns:` entry on 5349 — that is what works on
# a campus network that blocks UDP.
TURN_URLS="stun:localhost:3478,turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp"


# ── Service wiring ──────────────────────────────────────────────────────────

# Browser origins allowed to open a socket, comma-separated, exact-match, no
# trailing slash. Checked in the Socket.IO handshake before anything else
# (PLAN.md §11.4). Leave the wildcard out — an open origin list plus cookie auth
# is a CSRF-shaped hole.
ALLOWED_ORIGINS="http://localhost:3000"

# Where the browser opens its socket. Public (NEXT_PUBLIC_) because it is baked
# into the client bundle at build time. Use wss:// in production.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# Identifies this realtime process in Redis keys, presence records, metrics labels
# and log lines. With more than one instance running, this is how you tell which
# node owns a room's leader lock. On Fly, set it to the machine id:
#   NODE_ID=$FLY_MACHINE_ID
NODE_ID="local-1"

# pino level: trace | debug | info | warn | error | fatal
# `debug` locally is useful; anything below `info` in production is a bandwidth bill.
LOG_LEVEL="debug"


# ── Optional / local only ───────────────────────────────────────────────────

# Docker Compose reads `infra/.env`, not this file, because the project directory
# is the one holding the compose file. The compose service defaults already match
# the DATABASE_URL and REDIS_URL above, so you normally need nothing here. Create
# infra/.env only to move ports:
#   POSTGRES_PORT=5433
#   REDIS_PORT=6380
#   TURN_PORT=3478
