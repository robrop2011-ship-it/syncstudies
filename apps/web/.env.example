# ─────────────────────────────────────────────────────────────────────────────
# SyncStudy web (Next.js) — environment template
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js loads `.env.local` from the app directory, not from the repo root, so
# this file is separate from the root template even though the values overlap.
#
# NEXT_PUBLIC_* is inlined into the CLIENT BUNDLE at build time. Anything with that
# prefix is public forever. Never put a secret behind it — TURN_SECRET and
# IP_HASH_SALT are server-only and are absent from this file by design.
#
# Amendment A1: no SMTP, no mail provider key, no OAuth client id/secret. Accounts
# are handle + password with a one-time recovery code.
# ─────────────────────────────────────────────────────────────────────────────


# ── Server-side only ────────────────────────────────────────────────────────

# Prisma, used by the REST route handlers under app/api (auth, rooms, profile).
DATABASE_URL="postgresql://syncstudy:syncstudy@localhost:5432/syncstudy?schema=public"

# Salt for hashing client IPs before they are counted against a rate-limit bucket.
# Raw addresses never reach a row or a log line (PLAN.md §11.9).
# Generate: openssl rand -base64 32
# Must match the realtime service if you want one abuse counter rather than two.
IP_HASH_SALT="dev-ip-hash-salt-change-me"

# NOTE: the web tier has no REDIS_URL or LOG_LEVEL yet. Rate-limit buckets are
# in-process (see lib/server/rate-limit.ts) and route handlers log through the
# platform. Both arrive when the limiter moves onto the same Redis the realtime
# service uses — deliberately not listed here until they are actually read.


# ── Public: inlined into the browser bundle ─────────────────────────────────

# Where the room page opens its socket. Use wss:// in production.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# Origin that serves uploaded avatars. Must NOT be the app's own origin (§11.8).
# Leave unset in development to fall back to generated avatars.
# When set, its origin is added to the CSP img-src allowlist automatically.
NEXT_PUBLIC_AVATAR_BASE_URL=""

# Canonical origin of this deployment. Used to build shareable room links
# (`/r/K3M7-QP2X`) so a copied invite is absolute rather than relative.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
