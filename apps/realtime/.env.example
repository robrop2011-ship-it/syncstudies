# @syncstudy/realtime — environment.
#
# Names only. Real values live in the Fly secret store, never in the repo
# (PLAN.md §11.10). Every variable without a default is required at boot: the
# process refuses to start rather than discovering the gap on the first join.

# HTTP port for /health, /metrics and the WebSocket upgrade.
PORT=4000
NODE_ENV=development

# Postgres. Durable truth for membership, bans and video snapshots.
DATABASE_URL=postgresql://syncstudy:syncstudy@localhost:5432/syncstudy

# Redis. Live truth for the video anchor, presence and rate limits.
REDIS_URL=redis://localhost:6379

# Exact origins allowed to open a socket, comma separated. Socket.IO does not
# enforce same-origin by itself (§11.4) — this list is the whole control.
ALLOWED_ORIGINS=http://localhost:3000

# Salt for sha256(ip). Abuse prevention only; the address itself is never
# stored or logged (§11.9). Use at least 32 random characters in production.
IP_HASH_SALT=change-me-to-32-random-characters

# coturn REST-API credentials (Phase 6). Absent in dev: calling then falls back
# to STUN only, which works on most home networks.
# TURN_SECRET=
# TURN_URLS=turn:turn.syncstudy.app:3478?transport=udp,turns:turn.syncstudy.app:5349?transport=tcp

LOG_LEVEL=debug

# Identifies this process in leader leases and socket records. Defaults to
# hostname-pid, which is right for Fly.
# NODE_ID=
